# === Secrets — never commit ===
# Holds live DB credentials + auth salts. See wp-config.reference.php.
wp-config.php

# === WordPress core — kept on localhost, not version-controlled ===
# The site still runs locally from these; they're vendor code, restored with
# `wp core download` or from the host.
/wp-admin/
/wp-includes/
/index.php
/xmlrpc.php
/license.txt
/readme.html
/.htaccess
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php

# === NextGEN Gallery module cache — kept on localhost, not tracked ===
wp-content/ngg/

# === OS / editor cruft ===
.DS_Store
._*
*.swp
Thumbs.db

# === Logs ===
*.log
debug.log
wp-content/debug.log
wp-content/logs/
wp-content/compressx/log/

# === WordPress transient / update state ===
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/umbrella-upgrade-temp-backup/
wp-content/*-upgrade-temp-backup/
wp-content/cache/
wp-content/et-cache/
wp-content/uploads/cache/

# === Media ===
# Not tracked — uploads move to Cloudflare R2 (migration plan task 4.1).
# The folder is kept locally (empty) so WordPress can write to it.
wp-content/uploads/

# === Third-party plugins ===
# Not tracked. This repo version-controls our own code, not vendored plugin
# code that also has to sit on the server unrelated to this repo. Kept on
# localhost (and on the server) as plain files; reinstalled from scratch with
# bin/install-plugins.sh. Only our own in-house plugins stay tracked.
wp-content/plugins/*
!wp-content/plugins/figuro-folder/
!wp-content/plugins/custom_dashboard/
!wp-content/plugins/pdf-flipper/
!wp-content/plugins/index.php
